# ============================================================================
# KLIPZZ.VID ENVIRONMENT CONFIGURATION
# Single Next.js app: UI + API Route Handlers run on the same server.
# Copy this file to .env (Docker Compose) and/or frontend/.env.local (local dev).
# Never commit real secrets. .env files are gitignored.
# ============================================================================

# Supabase project credentials
SUPABASE_URL=https://your-project.supabase.co
# Browser-safe public key (anon / publishable). Safe to expose to the frontend.
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only secret, used by the Next.js Route Handlers. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Direct Postgres connection, used only by migration/seed scripts.
# Use the Supabase pooler connection string (port 6543).
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# Apify scraper API token (pay-per-result actors)
# Actors used:
# - apidojo/tiktok-scraper
# - sones/instagram-posts-scraper-lowcost
APIFY_API_TOKEN=apify_api_...

# Never fabricate metrics in production. Set true only for local demos.
ALLOW_SIMULATION=false
APIFY_TIMEOUT_MS=120000

# Secret for /api/cron/sync-metrics and /api/cron/cleanup.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-secret

# App config. Browser calls the same-origin Next.js API.
NEXT_PUBLIC_API_URL=/api

# Frontend public Supabase values (inlined at build time).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ----------------------------------------------------------------------------
# Plesk Scheduled Tasks (replace the old always-on worker)
# ----------------------------------------------------------------------------
# Every 15 minutes:
#   curl -fsS -H "Authorization: Bearer YOUR_CRON_SECRET" \
#     https://klipzz.rajaemas.dev/api/cron/sync-metrics
# Every hour:
#   curl -fsS -H "Authorization: Bearer YOUR_CRON_SECRET" \
#     https://klipzz.rajaemas.dev/api/cron/cleanup
